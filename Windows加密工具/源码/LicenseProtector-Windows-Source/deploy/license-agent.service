[Unit]
Description=LicenseProtector Linux authorization server (Agent)
After=local-fs.target

[Service]
Type=simple
User=license-agent
Group=www
SupplementaryGroups=license-agent
Environment=PYTHONPATH=/opt/license-protector-agent
ExecStart=/opt/license-protector-agent/venv/bin/python -m app.agent.cli agent-serve --config /etc/license-protector/agent.json
RuntimeDirectory=license-protector
RuntimeDirectoryMode=0770
UMask=007
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/license-protector-agent /etc/license-protector
ReadWritePaths=/run/license-protector

[Install]
WantedBy=multi-user.target
